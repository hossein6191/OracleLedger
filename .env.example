# Optional. With it, the 30-day backfill takes seconds via Envio HyperSync.
# Without it, the backfill runs over the public RPC in 10k-block chunks (a few minutes).
HYPERSYNC_TOKEN=

# Public Ethereum RPC used for live polling and as the backfill fallback.
RPC_URL=https://rpc.mevblocker.io

# How much history to keep, in days.
HISTORY_DAYS=30

# Poll interval for new updates, in seconds.
POLL_SECONDS=30

PORT=3000
